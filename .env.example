# Copie para .env e preencha. NUNCA commite .env.

# reCAPTCHA Enterprise site key (Firebase Console → App Check)
VITE_RECAPTCHA_SITE_KEY=

# Token de debug do App Check (APENAS para desenvolvimento local)
VITE_FIREBASE_APPCHECK_DEBUG=

# URL custom da Cloud Function (deixe vazio em produção; preenchido em dev)
VITE_FIREBASE_FUNCTIONS_URL=

# Se =1, conecta ao emulador de Auth em dev (porta 9099)
VITE_USE_AUTH_EMULATOR=
