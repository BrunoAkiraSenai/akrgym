# Copie para .env e preencha. NUNCA commite .env.

# reCAPTCHA Enterprise site key (Firebase Console → App Check)
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Token de debug do App Check (APENAS para desenvolvimento local; nunca produção)
VITE_FIREBASE_APPCHECK_DEBUG=

# URL do Worker Cloudflare (opcional; sem ela usa o Worker de produção padrão)
VITE_AI_BACKEND_URL=

# URL custom da Cloud Function (fallback legado, se ainda necessário)
VITE_FIREBASE_FUNCTIONS_URL=

# Se =1, conecta ao emulador de Auth em dev (porta 9099)
VITE_USE_AUTH_EMULATOR=
