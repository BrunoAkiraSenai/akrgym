// FIREBASE FIRESTORE SECURITY RULES — PRODUCAO
// users/{uid}/... — cada usuario so acessa os proprios dados
//
// Princípios:
//  - Negar tudo por padrão
//  - Validar UID do request.auth contra o path
//  - Validar tipo e forma dos campos (não apenas presença)
//  - Histórico de treino é append-only (criação + leitura, sem update)
//  - Validar campo usuarioId quando existir (defesa em profundidade)
//
// Testes: tests/firestore.rules.spec.js (Firebase Emulator Suite)

rules_version = '2'
service cloud.firestore {
  match /databases/{database}/documents {

    // NEGAR TUDO POR PADRAO
    match /{document=**} {
      allow read, write: if false;
    }

    // CONFIG: treino + refeicoes + metas são obrigatórios;
    // chaves extras são rejeitadas; tipos validados quando possível.
    match /users/{userId}/config/data {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.data.keys().hasAll(['metas', 'refeicoes', 'treinos'])
                   && request.resource.data.metas is map
                   && request.resource.data.refeicoes is list
                   && request.resource.data.treinos is map;
    }

    // HISTORICO DE TREINOS — append-only.
    //   - create: requer campos mínimos, tipos e ranges razoáveis
    //   - update: bloqueado (histórico é imutável)
    //   - delete: permitido (funcionalidade existente)
    match /users/{userId}/historico_treinos/{docId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.keys().hasAll(['rotina_id', 'data', 'exercicios'])
                    && request.resource.data.rotina_id is string
                    && request.resource.data.rotina_id.size() > 0
                    && request.resource.data.rotina_id.size() < 100
                    && request.resource.data.exercicios is list
                    && request.resource.data.exercicios.size() > 0
                    && request.resource.data.exercicios.size() < 100
                    && request.resource.data.data is timestamp;
      allow delete: if request.auth != null && request.auth.uid == userId;
      allow update: if false;
    }

    // DIARIO ALIMENTAR
    //   - chaves permitidas: refeicoes, data, extras_globais (+ opcionais updatedAt, usuarioId)
    //   - tipos validados
    match /users/{userId}/diario_dieta/{docId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      function isValidDietWrite() {
        return request.auth != null
               && request.auth.uid == userId
               && request.resource.data.refeicoes is map
               && request.resource.data.data is string
               // O formato também restringe mês e dia aos intervalos possíveis.
               // A validação completa de dias por mês continua sendo responsabilidade
               // do cliente/servidor, pois as regras não possuem um parser de datas.
               && request.resource.data.data.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
               && request.resource.data.extras_globais is list
               && request.resource.data.extras_globais.size() < 100
               // Defesa em profundidade: se o documento incluir usuarioId, ele deve ser o dono.
               && (!('usuarioId' in request.resource.data)
                   || request.resource.data.usuarioId == request.auth.uid);
      }
      allow create, update: if isValidDietWrite();
    }

    // HISTORICO CORPORAL
    //   - peso obrigatório (>= 0)
    //   - data obrigatória
    //   - outras medidas opcionais, mas se presentes devem ser number >= 0
    match /users/{userId}/historico_corporal/{docId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.keys().hasAll(['peso', 'data'])
                    && request.resource.data.peso is number
                    && request.resource.data.peso >= 0
                    && request.resource.data.peso < 1000
                    && request.resource.data.data is timestamp;
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.peso is number
                    && request.resource.data.peso >= 0
                    && request.resource.data.peso < 1000
                    && request.resource.data.data is timestamp
                    && request.resource.data.data <= request.time;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ================= AMIGOS (dias de dieta) =================
    // Só quem tem conta real participa; visitante anônimo fica de fora.
    function contaReal() {
      return request.auth != null
             && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    // Mesmo ID para o par, independentemente de quem pediu (ver idAmizade no cliente).
    function parId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }
    function saoAmigos(a, b) {
      return exists(/databases/$(database)/documents/amizades/$(parId(a, b)))
             && get(/databases/$(database)/documents/amizades/$(parId(a, b))).data.status == 'aceita';
    }
    function codigoValido(codigo) {
      return codigo is string && codigo.matches('^[A-HJKMNP-Z2-9]{8}$');
    }

    // CODIGO -> UID. Só leitura direta: sem listagem, ninguém enumera usuários.
    match /codigos_amizade/{codigo} {
      allow get: if contaReal();
      allow create: if contaReal()
                    && codigoValido(codigo)
                    && request.resource.data.keys().hasOnly(['uid'])
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // PERFIL: nome, foto e código. Quem tem o UID (via código ou amizade) lê;
    // listar perfis é proibido.
    match /perfis/{userId} {
      function perfilValido() {
        let d = request.resource.data;
        return d.keys().hasOnly(['nome', 'foto', 'codigo', 'atualizadoEm'])
               && d.keys().hasAll(['nome', 'foto', 'codigo'])
               && d.nome is string && d.nome.size() > 0 && d.nome.size() <= 40
               && d.foto is string && d.foto.size() <= 60000
               && (d.foto == '' || d.foto.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$'))
               && codigoValido(d.codigo);
      }
      allow get: if contaReal();
      allow create: if contaReal()
                    && request.auth.uid == userId
                    && perfilValido()
                    // O código do perfil precisa ser o que a própria pessoa registrou.
                    && getAfter(/databases/$(database)/documents/codigos_amizade/$(request.resource.data.codigo)).data.uid == request.auth.uid;
      allow update: if contaReal()
                    && request.auth.uid == userId
                    && perfilValido()
                    && request.resource.data.codigo == resource.data.codigo;
      allow delete: if request.auth != null && request.auth.uid == userId;

      // RESUMO DA DIETA: o dono escreve; só amigos aceitos leem.
      match /compartilhado/dieta {
        function resumoValido() {
          let d = request.resource.data;
          return d.keys().hasOnly(['sequencia', 'acertos30', 'ultimos7', 'ate', 'atualizadoEm'])
                 && d.keys().hasAll(['sequencia', 'acertos30', 'ultimos7', 'ate'])
                 && d.sequencia is int && d.sequencia >= 0 && d.sequencia <= 30
                 && d.acertos30 is int && d.acertos30 >= 0 && d.acertos30 <= 30
                 && d.ultimos7 is list && d.ultimos7.size() == 7
                 && d.ultimos7.hasOnly(['ok', 'fora', 'vazio'])
                 && d.ate is string && d.ate.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
        }
        allow get: if request.auth != null
                   && (request.auth.uid == userId || saoAmigos(request.auth.uid, userId));
        allow create, update: if contaReal() && request.auth.uid == userId && resumoValido();
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // CALENDARIO DO MES (mes-YYYY-MM): por dia, 'ok' ou a diferença em kcal
      // para a meta. O dono escreve e lista; só amigos aceitos leem.
      match /compartilhado/{docId} {
        function calendarioValido() {
          let d = request.resource.data;
          return docId.matches('^mes-[0-9]{4}-(0[1-9]|1[0-2])$')
                 && d.keys().hasOnly(['dias', 'atualizadoEm'])
                 && d.dias is map
                 && d.dias.size() <= 31;
        }
        allow get: if request.auth != null
                   && (request.auth.uid == userId || saoAmigos(request.auth.uid, userId));
        allow list: if request.auth != null && request.auth.uid == userId;
        allow create, update: if contaReal() && request.auth.uid == userId && calendarioValido();
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // AMIZADE: um documento por par. Quem pede cria como 'pendente'; só a
    // outra pessoa aceita; qualquer um dos dois pode apagar.
    match /amizades/{amizadeId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.membros;
      allow create: if contaReal()
                    && request.resource.data.keys().hasOnly(['membros', 'solicitante', 'status', 'criadoEm', 'atualizadoEm'])
                    && request.resource.data.membros is list
                    && request.resource.data.membros.size() == 2
                    && request.resource.data.membros[0] is string
                    && request.resource.data.membros[1] is string
                    && request.resource.data.membros[0] < request.resource.data.membros[1]
                    && amizadeId == request.resource.data.membros[0] + '_' + request.resource.data.membros[1]
                    && request.auth.uid in request.resource.data.membros
                    && request.resource.data.solicitante == request.auth.uid
                    && request.resource.data.status == 'pendente';
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.membros
                    && request.auth.uid != resource.data.solicitante
                    && resource.data.status == 'pendente'
                    && request.resource.data.status == 'aceita'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'atualizadoEm']);
      allow delete: if request.auth != null && request.auth.uid in resource.data.membros;
    }

  }
}
